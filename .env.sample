DJANGO_BASE_URL="http://127.0.0.1:8001"

# Google OAuth Client ID (for "Sign in with Google" button)
# Get this from Google Cloud Console: https://console.cloud.google.com/
# Create an OAuth 2.0 Client ID for Web application
# Add authorized JavaScript origins: http://localhost:3000
# Set in .env.local (which is gitignored) — do not commit real credentials
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Allowed dev origins — comma-separated LAN IPs/hostnames for Next.js dev server
# Required when accessing the dev server from another device on your network
# (e.g. phone, second computer, tablet)
#
# Set in .env.local (which is gitignored) — do not commit real IPs
# Example:
# ALLOWED_DEV_ORIGINS=192.168.1.100,192.168.1.101
#
# Then restart the dev server (npm run dev) for changes to take effect
# ALLOWED_DEV_ORIGINS=